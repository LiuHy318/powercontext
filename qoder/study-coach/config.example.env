# StudyRecall 配置示例
# 复制为 .env 或直接设置环境变量。此文件只含占位值，不含任何真实凭据。
# 默认在本地回环（127.0.0.1）以 Access Mode=disabled 运行，无需任何 Token。

# ---- StudyRecall 应用 ----
# 应用连接的真实 PowerContext Server 地址（HTTP API）。
STUDYRECALL_SERVER_URL=http://127.0.0.1:8777
# 请求超时（秒）。
STUDYRECALL_TIMEOUT=20

# ---- PowerContext Server（仅当自行启动服务时相关）----
# 本地持久化目录；SQLite 数据库文件将写入 $POWERCONTEXT_HOME/powercontext.db。
# 生产环境请改为受控目录；本项目脚本默认使用 ./qoder/study-coach/.runtime 下子目录（已被 .gitignore 忽略）。
POWERCONTEXT_HOME=/absolute/path/to/replace-with-your-data-dir

# 若需要非回环暴露，必须启用鉴权并设置 Bearer Token（占位，切勿提交真实值）：
# POWERCONTEXT_SERVER_ACCESS_MODE=enforced
# POWERCONTEXT_SERVER_AUTH_TOKEN=<replace-with-your-token>
# POWERCONTEXT_SERVER_HTTP_HOST=0.0.0.0

# 说明：本项目不使用任何外部收费模型，不配置 generation/embedding 模型，
# 记忆检索仅使用 PowerContext 全文检索（FTS），不做语义/向量声明。
