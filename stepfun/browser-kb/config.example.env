# Optional: connect seekdb-js to an already running LOCAL seekdb server.
# By default, npm start manages a local native seekdb process itself.
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
# SEEKDB_DATABASE=test
PORT=8027
# Optional data directory (persistent; do not place under public/):
# SEEKDB_PATH=C:/path/to/edgekb-data
# Model downloader only, not an inference provider:
# HF_ENDPOINT=https://huggingface.co
