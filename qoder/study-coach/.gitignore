# Runtime-generated state and installed dependencies are NOT tracked.

# Local PowerContext storage, test data and logs created by scripts/tests
.runtime/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local runtime config (personal env files stay out of source; the tracked
# template is config.example.env, which is NOT matched by these patterns)
.env
.env.*

# OS noise
.DS_Store
Thumbs.db
